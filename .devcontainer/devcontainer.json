{
  "name": "tundraboard",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/tundraboard",
  "shutdownAction": "stopCompose",
  "remoteUser": "node",
  "updateRemoteUserUID": true,
  "containerEnv": {
    "DATABASE_URL": "postgresql://postgres:postgres@db:5432/tundraboard_dev",
    "PGHOST": "db",
    "PGUSER": "postgres",
    "PGPASSWORD": "postgres",
    "PGDATABASE": "tundraboard_dev",
    "GIT_EDITOR": "code --wait"
  },
  "mounts": [
    "source=${localEnv:USERPROFILE}/.ssh,target=/tmp/.ssh,type=bind,consistency=cached",
    "source=${localEnv:USERPROFILE}/.config/gh,target=/tmp/gh-config,type=bind,consistency=cached",
    "source=${localEnv:USERPROFILE}/.gitconfig,target=/tmp/.gitconfig,type=bind,consistency=cached"
  ],
  "forwardPorts": [3000, 5432],
  "portsAttributes": {
    "3000": {
      "label": "TundraBoard API",
      "onAutoForward": "notify"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash -lc 'cd /workspaces/tundraboard && if ! pgrep -f \"tsx watch src/index.ts\" >/dev/null; then npm run dev >/tmp/tundraboard-dev.log 2>&1 & fi'",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.eol": "\n",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        }
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "Prisma.prisma",
        "ms-vscode.vscode-typescript-next",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "github.vscode-github-actions",
        "GitHub.vscode-pull-request-github"
      ]
    }
  }
}
