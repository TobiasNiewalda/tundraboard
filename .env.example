# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tundraboard_dev"

# Server
PORT=3000
NODE_ENV=development

# JWT Authentication
JWT_SECRET="change-me-to-a-real-secret-in-production"
JWT_EXPIRES_IN="24h"

# CORS
CORS_ORIGIN="http://localhost:5173"

# OpenRouter usage metrics (scripts/fetch_ai_usage.js)
# Any API key gives monthly spend; a management key (Settings -> API Keys ->
# Manage) additionally unlocks token utilisation and per-model breakdown.
OPENROUTER_API_KEY="sk-or-v1-..."
# OPENROUTER_MANAGEMENT_KEY="sk-or-v1-..."
