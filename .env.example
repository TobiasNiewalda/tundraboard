# Database — point at your local/dev PostgreSQL. For the Docker quickstart in
# the README, use the user/password you passed to the container:
#   postgresql://<user>:<password>@localhost:5432/tundraboard_dev
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/tundraboard_dev"

# Server
PORT=3000
NODE_ENV=development

# JWT Authentication
JWT_SECRET="change-me-to-a-real-secret-in-production"
JWT_EXPIRES_IN="24h"

# CORS
CORS_ORIGIN="http://localhost:5173"

# OpenRouter usage metrics (scripts/fetch_ai_usage.js)
# Any API key gives monthly spend; a management key (Settings -> API Keys ->
# Manage) additionally unlocks token utilisation, per-model breakdown, and the
# monthly history that generate-fact-sheet.mjs computes the trend from.
OPENROUTER_API_KEY="sk-or-v1-..."
# OPENROUTER_MANAGEMENT_KEY="sk-or-v1-..."
# Months of usage history the fact sheet collects (complete months + the
# current month to date). Default 4 = 3 complete + current MTD; max 24.
# The npm run ai:usage snippet always stays a single-month view.
# AI_USAGE_LOOKBACK_MONTHS=4
